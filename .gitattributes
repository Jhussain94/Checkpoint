# Treat all image and audio files as binary — prevents git from mangling them
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.otf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.ogg  binary

# Normalise line endings for text files
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.bat   text eol=crlf
*.sh    text eol=lf
